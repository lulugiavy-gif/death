-- ===== HOP SERVER =====
local function hopServer(preferRich)
	if Hopping then
		setStatus("Đang hop...")
		return
	end
	Hopping = true
	setStatus("Đang tìm server...")
	task.spawn(function()
		local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100", game.PlaceId)
		local ok, raw = pcall(function() return game:HttpGet(url) end)
		if not ok or type(raw) ~= "string" then
			Hopping = false
			setStatus("Chặn HttpGet: đổi server ở menu")
			return
		end
		local decOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not decOk or type(data) ~= "table" or type(data.data) ~= "table" then
			Hopping = false
			setStatus("Lỗi dữ liệu server")
			return
		end
		local list = {}
		for _, s in ipairs(data.data) do
			if type(s) == "table" and type(s.id) == "string" and s.id ~= game.JobId then
				local p = tonumber(s.playing) or 0
				local m = tonumber(s.maxPlayers) or 0
				if m > 0 and p < m then
					table.insert(list, { id = s.id, p = p, m = m })
				end
			end
		end
		if #list == 0 then
			Hopping = false
			setStatus("Không có server khác")
			return
		end
		if preferRich then
			table.sort(list, function(a, b) return a.p > b.p end)
		else
			local idx = math.random(1, #list)
			list[1], list[idx] = list[idx], list[1]
		end
		setStatus(string.format("Hop %d/%d...", list[1].p, list[1].m))
		local tpOk, err = pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, list[1].id, LocalPlayer)
		end)
		if not tpOk then
			Hopping = false
			setStatus("Hop lỗi: " .. tostring(err))
		end
	end)
end

-- ===== ESP BRAINROT (TRONG NHÀ, BỎ CHẠY NGOÀI, CHỮ NHỎ) =====
local function fmtRate(n)
	if type(n) ~= "number" or n ~= n then return nil end
	local a = math.abs(n)
	if a >= 1e12 then return string.format("%.2fT/s", n / 1e12)
	elseif a >= 1e9 then return string.format("%.2fB/s", n / 1e9)
	elseif a >= 1e6 then return string.format("%.2fM/s", n / 1e6)
	elseif a >= 1e3 then return string.format("%.1fK/s", n / 1e3)
	else return string.format("%.0f/s", n) end
end

local function parseRate(txt)
	if type(txt) ~= "string" then return nil end
	local num, suf = txt:gsub(",", ""):match("([%d%.]+)%s*([KMBTkmbt]?)%s*/%s*[sS]")
	if not num then return nil end
	local v = tonumber(num)
	if not v then return nil end
	local mult = ({ K = 1e3, M = 1e6, B = 1e9, T = 1e12 })[(suf or ""):upper()] or 1
	return fmtRate(v * mult)
end

local function getPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart", true) or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function isInHouseNotRoaming(inst, part)
	if not part then return false end
	local hum = inst:FindFirstChildOfClass("Humanoid") or inst:FindFirstChildWhichIsA("Humanoid", true)
	if hum and hum.WalkSpeed > 0 and (hum.MoveDirection.Magnitude > 0.05 or part.AssemblyLinearVelocity.Magnitude > 1.5) then
		return false
	end
	if not hum and part.AssemblyLinearVelocity.Magnitude > 3 then
		return false
	end
	local cur = inst.Parent
	while cur and cur ~= Workspace do
		local low = cur.Name:lower()
		if low:find("base", 1, true) or low:find("house", 1, true) or low:find("home", 1, true) or low:find("plot", 1, true) or low:find("room", 1, true) or low:find("placed", 1, true) then
			return true
		end
		if low:find("roam", 1, true) or low:find("wander", 1, true) or low:find("outside", 1, true) or low:find("wild", 1, true) then
			return false
		end
		cur = cur.Parent
	end
	local ok, parts = pcall(function()
		local op = OverlapParams.new()
		op.FilterType = Enum.RaycastFilterType.Exclude
		op.FilterDescendantsInstances = myChar() and { myChar(), inst } or { inst }
		return Workspace:GetPartBoundsInRadius(part.Position, 10, op)
	end)
	if ok and type(parts) == "table" then
		local hits = 0
		for _, p in ipairs(parts) do
			if p:IsA("BasePart") and not (p.Size.X > 150 and p.Size.Z > 150) then
				hits += 1
				if hits >= 2 then return true end
			end
		end
	end
	return false
end

local function getInfo(inst)
	local name = inst.Name:gsub("_", " ")
	local rate = nil
	for k, v in pairs(inst:GetAttributes()) do
		local kl = k:lower()
		if type(v) == "string" and (kl:find("brainrot", 1, true) or kl:find("title", 1, true)) and v ~= "" then
			name = v
		elseif type(v) == "number" and (kl:find("rate", 1, true) or kl:find("income", 1, true) or kl:find("sec", 1, true)) then
			rate = rate or fmtRate(v)
		end
	end
	for _, d in ipairs(inst:GetDescendants()) do
		local dl = d.Name:lower()
		if d:IsA("StringValue") and d.Value ~= "" and (dl:find("brainrot", 1, true) or dl:find("title", 1, true)) then
			name = d.Value
		elseif (d:IsA("NumberValue") or d:IsA("IntValue")) and (dl:find("rate", 1, true) or dl:find("income", 1, true) or dl:find("sec", 1, true)) then
			rate = rate or fmtRate(d.Value)
		elseif d:IsA("TextLabel") or d:IsA("TextButton") then
			rate = rate or parseRate(d.Text)
		end
	end
	return rate and (name .. " | +" .. rate) or (name .. " | ?/s")
end

local function clearEsp()
	for k, v in pairs(activeEsp) do
		if v and v.gui then pcall(function() v.gui:Destroy() end) end
		activeEsp[k] = nil
	end
end

local function scanEsp(force)
	if not Flags.Esp then
		if next(activeEsp) then clearEsp() end
		return
	end
	if not force and os.clock() - lastScan < 0.8 then return end
	lastScan = os.clock()

	local char = myChar()
	local seen = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj:IsA("Model") or obj:IsA("BasePart")) and not (char and (obj == char or obj:IsDescendantOf(char))) then
			local n = obj.Name:lower()
			local isBr = n:find("brainrot", 1, true)
			if not isBr then
				for _, d in ipairs(obj:GetDescendants()) do
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and (d.Text:lower():find("brainrot", 1, true) or parseRate(d.Text) ~= nil) then
						isBr = true
						break
					end
				end
			end
			if isBr then
				local part = getPart(obj)
				if isInHouseNotRoaming(obj, part) then
					seen[obj] = true
					if not activeEsp[obj] then
						local bb = Instance.new("BillboardGui")
						bb.Adornee = part
						bb.AlwaysOnTop = true
						bb.MaxDistance = 135
						bb.Size = UDim2.new(0, 114, 0, 14)
						bb.StudsOffset = Vector3.new(0, 2.2, 0)
						bb.Parent = espFolder

						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.new(1, 0, 1, 0)
						lbl.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
						lbl.BackgroundTransparency = 0.35
						lbl.TextColor3 = Color3.fromRGB(120, 255, 175)
						lbl.Font = Enum.Font.GothamBold
						lbl.TextSize = 10
						lbl.TextScaled = false
						lbl.TextTruncate = Enum.TextTruncate.AtEnd
						lbl.Text = getInfo(obj)
						lbl.Parent = bb
						Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)

						activeEsp[obj] = { gui = bb, lbl = lbl }
					else
						activeEsp[obj].lbl.Text = getInfo(obj)
					end
				end
			end
		end
	end
	for k, v in pairs(activeEsp) do
		if not seen[k] or not k.Parent then
			if v and v.gui then pcall(function() v.gui:Destroy() end) end
			activeEsp[k] = nil
		end
	end
end

