-- ===== FIX LAG (GIẢM HIỆU ỨNG / ĐỒ HỌA NẶNG) =====
local function applyFixLag(enable)
	if enable then
		if not savedLighting then
			savedLighting = {
				GlobalShadows = Lighting.GlobalShadows,
				Brightness = Lighting.Brightness,
				EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
				EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
			}
		end
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.EnvironmentSpecularScale = 0
			Lighting.EnvironmentDiffuseScale = 0
		end)

		for _, obj in ipairs(Lighting:GetDescendants()) do
			if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") then
				if savedEffects[obj] == nil and (obj:IsA("PostEffect") or obj:IsA("Atmosphere")) then
					savedEffects[obj] = obj.Enabled
				end
				if obj:IsA("PostEffect") or obj:IsA("Atmosphere") then
					pcall(function() obj.Enabled = false end)
				end
			end
		end

		local count = 0
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
				if savedEffects[obj] == nil then
					savedEffects[obj] = obj.Enabled
				end
				pcall(function() obj.Enabled = false end)
			elseif obj:IsA("BasePart") and not savedParts[obj] then
				savedParts[obj] = {
					Material = obj.Material,
					CastShadow = obj.CastShadow,
					Reflectance = obj.Reflectance,
				}
				pcall(function()
					obj.Material = Enum.Material.SmoothPlastic
					obj.CastShadow = false
					obj.Reflectance = 0
				end)
			end
			count += 1
			if count % 600 == 0 then
				task.wait()
			end
		end
	else
		if savedLighting then
			pcall(function()
				Lighting.GlobalShadows = savedLighting.GlobalShadows
				Lighting.Brightness = savedLighting.Brightness
				Lighting.EnvironmentSpecularScale = savedLighting.EnvironmentSpecularScale
				Lighting.EnvironmentDiffuseScale = savedLighting.EnvironmentDiffuseScale
			end)
			savedLighting = nil
		end
		for obj, enabled in pairs(savedEffects) do
			if obj and obj.Parent then
				pcall(function()
					if typeof(enabled) == "boolean" then
						obj.Enabled = enabled
					end
				end)
			end
			savedEffects[obj] = nil
		end
		for part, prop in pairs(savedParts) do
			if part and part.Parent then
				pcall(function()
					part.Material = prop.Material
					part.CastShadow = prop.CastShadow
					part.Reflectance = prop.Reflectance
				end)
			end
			savedParts[part] = nil
		end
	end
end

