local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH HUB | AN TOÀN TUYỆT ĐỐI", 
    KeySystem = true, 
    KeySettings = {
        Title = "DEATH KEY SYSTEM", 
        Subtitle = "Nhập key để sử dụng script", 
        Key = "death2026", 
        SaveKey = true
    }
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)
local isRunning = false

Tab:CreateToggle({
    Name = "Đoán sét (Chỉ bắt đầu khi bạn trồng cây)",
    CurrentValue = false,
    Callback = function(v)
        isRunning = v
        if v then
            Rayfield:Notify({Title = "DEATH HUB", Content = "Đã bật! Hãy trồng cây để hệ thống theo dõi chuẩn xác...", Duration = 3})
            
            -- Theo dõi nhân vật của bạn để xem khi nào bạn đặt/trồng cây
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            
            -- Lắng nghe xem có vật thể nào được tạo ra NGAY GẦN BẠN không (Chính là cây bạn vừa trồng)
            Workspace.ChildAdded:Connect(function(child)
                if not isRunning then return end
                
                -- Kiểm tra xem vật thể đó có xuất hiện sát vị trí của bạn không (khoảng cách dưới 10 mét)
                -- Cách này đảm bảo chỉ khi BẠN trồng cây thì script mới nhận diện, kệ những người khác hay vật thể khác trong map
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    if child:IsA("Model") or child:IsA("Part") then
                        -- Kiểm tra vị trí của vật thể mới sinh ra so với bạn
                        local pos = (child:IsA("Model") and child.PrimaryPart and child.PrimaryPart.Position) or (child:IsA("Part") and child.Position)
                        
                        if pos and (pos - hrp.Position).Magnitude < 12 then
                            local n = string.lower(child.Name)
                            -- Nếu đúng là vật phẩm trồng cây xuất hiện ngay chỗ bạn
                            if string.find(n, "plant") or string.find(n, "tree") or string.find(n, "seed") or string.find(n, "crop") or string.find(n, "stem") then
                                
                                Rayfield:Notify({Title = "Đã nhận diện cây!", Content = "Bắt đầu chu kỳ canh sét cho cây của bạn...", Duration = 2})
                                
                                -- Đợi đúng thời gian chu kỳ của game rồi báo trước 2 giây để thu hoạch
                                -- (Bạn có thể điều chỉnh số giây bên dưới nếu game của bạn có thời gian khác)
                                task.spawn(function()
                                    -- Giả sử tổng thời gian từ lúc trồng đến lúc sét đánh là X giây
                                    -- Ở đây chúng ta sẽ báo trước 2 giây ở giai đoạn cuối
                                    task.wait(10) -- Thay đổi thời gian chờ tổng thể nếu cần (ví dụ cây lớn nhanh hay chậm)
                                    
                                    if isRunning then
                                        Rayfield:Notify({Title = "Tín hiệu 1", Content = "Nhịp giả thứ 1...", Duration = 1})
                                    end
                                    
                                    task.wait(3)
                                    if isRunning then
                                        Rayfield:Notify({Title = "Tín hiệu 2", Content = "Nhịp giả thứ 2...", Duration = 1})
                                    end
                                    
                                    task.wait(3)
                                    if isRunning then
                                        Rayfield:Notify({
                                            Title = "⚡ THU HOẠCH NGAY!", 
                                            Content = "Nhịp 3 - Trước sét 2 giây, bấm ngay!", 
                                            Duration = 4
                                        })
                                    end
                                end)
                            end
                        end
                    end
                end
            end)
        end
    end
})

-- Nút Hop Server 1 người
Tab:CreateButton({
    Name = "🔄 Đổi Server (Tìm phòng ít người)",
    Callback = function()
        Rayfield:Notify({Title = "SERVER HOP", Content = "Đang tìm server vắng người...", Duration = 2})
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    if s.playing < s.maxPlayers - 1 then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server phù hợp!", Duration = 3})
        end
    end,
})
