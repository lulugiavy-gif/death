local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH HUB | PRECISION & HOP", 
    KeySystem = true, 
    KeySettings = {
        Title = "DEATH KEY SYSTEM", 
        Subtitle = "Nhập key để sử dụng script", 
        Key = "death2026", 
        SaveKey = true
    }
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)
local count = 0
local isProcessing = false

-- Tính năng Đoán sét (Báo lần 3 - Chuẩn 2s)
Tab:CreateToggle({
    Name = "Đoán sét (Báo lần 3 - Chuẩn 2s)",
    CurrentValue = false,
    Callback = function(v)
        if v then
            count = 0
            Rayfield:Notify({Title = "DEATH HUB", Content = "Hệ thống đang đếm tín hiệu...", Duration = 2})
            
            Workspace.DescendantAdded:Connect(function(obj)
                local n = string.lower(obj.Name)
                if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or string.find(n, "lightning") or string.find(n, "effect") then
                    
                    count = count + 1
                    
                    -- Lần 1 và 2 bỏ qua, đến lần thứ 3 mới xử lý
                    if count == 3 and not isProcessing then
                        isProcessing = true
                        
                        -- Chờ đúng thời điểm chuẩn bị sét đánh (2 giây)
                        task.wait(2) 
                        
                        Rayfield:Notify({
                            Title = "⚡ SÉT THẬT! (2 GIÂY)", 
                            Content = "Thu hoạch ngay lập tức!", 
                            Duration = 2.5
                        })
                        
                        -- Reset lại bộ đếm cho đợt sét tiếp theo
                        task.wait(5)
                        count = 0
                        isProcessing = false
                    end
                end
            end)
        else
            count = 0
            isProcessing = false
        end
    end
})

-- Tính năng Hop Server 1 người (Ít người/Không lag)
Tab:CreateButton({
    Name = "🔄 Đổi Server (Tìm phòng ít người)",
    Callback = function()
        Rayfield:Notify({Title = "SERVER HOP", Content = "Đang tìm server vắng người...", Duration = 2})
        
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    -- Lọc các server có ít người chơi (ví dụ dưới 3 người hoặc ưu tiên server thưa)
                    if s.playing < s.maxPlayers - 1 then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            -- Chọn ngẫu nhiên một server trong danh sách vắng
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server phù hợp, thử lại sau!", Duration = 3})
        end
    end,
})
