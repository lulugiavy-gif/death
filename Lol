local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH HUB | VIP",
    KeySystem = true,
    KeySettings = {
        Title = "DEATH HUB KEY",
        Subtitle = "Xác thực truy cập",
        FileName = "DeathHubConfig",
        SaveKey = true,
        GrabKeyFromSite = false,
        Key = {"deathvip"}
    }
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)
local isRunning = false
local lastPlantTime = 0

Tab:CreateToggle({
    Name = "Đoán sét chuẩn 3 nhịp",
    CurrentValue = false,
    Callback = function(v)
        isRunning = v
        if v then
            Rayfield:Notify({Title = "DEATH HUB", Content = "Đã bật canh sét!", Duration = 1.5})
            
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            
            Workspace.ChildAdded:Connect(function(child)
                if not isRunning then return end
                
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    if child:IsA("Model") or child:IsA("Part") then
                        local pos = (child:IsA("Model") and child.PrimaryPart and child.PrimaryPart.Position) or (child:IsA("Part") and child.Position)
                        
                        if pos and (pos - hrp.Position).Magnitude < 12 then
                            local n = string.lower(child.Name)
                            if string.find(n, "plant") or string.find(n, "seed") or string.find(n, "tree") or string.find(n, "crop") or string.find(n, "stem") then
                                
                                local currentTime = tick()
                                if currentTime - lastPlantTime >= 1.0 then
                                    lastPlantTime = currentTime
                                    
                                    task.spawn(function()
                                        -- Nhịp 1: cách 2 giây
                                        task.wait(2.0) 
                                        if not isRunning then return end
                                        Rayfield:Notify({Title = "Đếm nhịp", Content = "Nhịp 1/3", Duration = 0.5})
                                        
                                        -- Nhịp 2: cách 2 giây
                                        task.wait(2.0) 
                                        if not isRunning then return end
                                        Rayfield:Notify({Title = "Đếm nhịp", Content = "Nhịp 2/3", Duration = 0.5})
                                        
                                        -- Nhịp 3: cách 3 giây (Thu hoạch)
                                        task.wait(3.0) 
                                        if not isRunning then return end
                                        Rayfield:Notify({
                                            Title = "⚡ THU HOẠCH NGAY!", 
                                            Content = "Đúng nhịp 3!", 
                                            Duration = 2.0
                                        })
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
})

Tab:CreateButton({
    Name = "🔄 Đổi Server Vắng (Hop 1 người)",
    Callback = function()
        Rayfield:Notify({Title = "DEATH HUB", Content = "Đang tìm phòng vắng...", Duration = 1.5})
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    if s.playing < 2 then 
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server vắng!", Duration = 2})
        end
    end,
})
