local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH 3.0 | CANH SÉT VIP",
    KeySystem = true,
    KeySettings = {
        Title = "DEATH KEY",
        Subtitle = "Hệ thống xác thực",
        FileName = "DeathKeyConfig",
        SaveKey = true,
        GrabKeyFromSite = false,
        Key = {"deathvip"} -- Key mới bảo mật của bạn
    }
})

local Tab = Window:CreateTab("Canh Sét & Server", 4483363465)
local isRunning = false
local lastPlantTime = 0

Tab:CreateToggle({
    Name = "Đoán sét chuẩn 3 nhịp",
    CurrentValue = false,
    Callback = function(v)
        isRunning = v
        if v then
            Rayfield:Notify({Title = "ĐÃ BẬT", Content = "Hãy trồng cây để canh sét...", Duration = 1.5})
            
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            
            Workspace.ChildAdded:Connect(function(child)
                if not isRunning then return end
                
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    if child:IsA("Model") or child:IsA("Part") then
                        local pos = (child:IsA("Model") and child.PrimaryPart and child.PrimaryPart.Position) or (child:IsA("Part") and child.Position)
                        
                        if pos and (pos - hrp.Position).Magnitude < 12 then
                            local n = string.lower(child.Name)
                            if string.find(n, "plant") or string.find(n, "seed") or string.find(n, "tree") or string.find(n, "crop") or string.find(n, "stem") then
                                
                                local currentTime = tick()
                                if currentTime - lastPlantTime >= 1.0 then
                                    lastPlantTime = currentTime
                                    
                                    -- Đủ 3 nhịp thông báo gọn gàng, nhanh chóng
                                    task.spawn(function()
                                        task.wait(8) -- Thời gian chờ đến nhịp 1
                                        if not isRunning then return end
                                        Rayfield:Notify({Title = "Nhịp 1", Content = "Đang đếm...", Duration = 0.8})
                                        
                                        task.wait(2.5) -- Thời gian đến nhịp 2
                                        if not isRunning then return end
                                        Rayfield:Notify({Title = "Nhịp 2", Content = "Gần tới...", Duration = 0.8})
                                        
                                        task.wait(2.5) -- Thời gian đến nhịp 3 (Báo trước 2s để thu hoạch)
                                        if not isRunning then return end
                                        Rayfield:Notify({
                                            Title = "⚡ THU HOẠCH NGAY!", 
                                            Content = "Trước sét 2 giây!", 
                                            Duration = 2
                                        })
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
})

Tab:CreateButton({
    Name = "🔄 Đổi Server Vắng Người",
    Callback = function()
        Rayfield:Notify({Title = "SERVER HOP", Content = "Đang tìm phòng...", Duration = 1.5})
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    if s.playing < s.maxPlayers - 1 then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server!", Duration = 2})
        end
    end,
})
