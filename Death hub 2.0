local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH 2.0 | PREDICT", 
    KeySystem = true, 
    KeySettings = {Title = "DEATH KEY", Key = "death2026", SaveKey = true}
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)

local connection = nil
local notificationCount = 0

Tab:CreateToggle({
    Name = "Đoán trước 2 giây (Pre-Strike)",
    Callback = function(v)
        if v then
            Rayfield:Notify({Title = "DEATH", Content = "Đã kích hoạt hệ thống quét 3 lần thông báo!", Duration = 2})
            
            -- Lắng nghe sự xuất hiện của vật thể mới
            connection = Workspace.DescendantAdded:Connect(function(obj)
                local n = string.lower(obj.Name)
                if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or string.find(n, "lightning") or string.find(n, "effect") then
                    
                    notificationCount = notificationCount + 1
                    
                    if notificationCount == 1 then
                        -- Thông báo giả lần 1
                        Rayfield:Notify({
                            Title = "⚡ CẢNH BÁO [1/3]", 
                            Content = "Tín hiệu giả (Lần 1)...", 
                            Duration = 1.5
                        })
                    elseif notificationCount == 2 then
                        -- Thông báo giả lần 2
                        Rayfield:Notify({
                            Title = "⚡ CẢNH BÁO [2/3]", 
                            Content = "Tín hiệu giả (Lần 2)... Chuẩn bị...", 
                            Duration = 1.5
                        })
                    elseif notificationCount >= 3 then
                        -- Thông báo thật lần 3 (đúng trước 2 giây để thu hoạch)
                        Rayfield:Notify({
                            Title = "⚡ THÔNG BÁO CHÍNH XÁC [3/3]", 
                            Content = "Sét thật! Thu hoạch ngay trong 2 giây tới!", 
                            Duration = 3
                        })
                        
                        -- Reset lại bộ đếm sau khi hoàn thành chu kỳ để sẵn sàng cho lần tiếp theo
                        notificationCount = 0
                    end
                end
            end)
        else
            -- Ngắt kết nối khi tắt Toggle để tránh tốn tài nguyên
            if connection then
                connection:Disconnect()
                connection = nil
            end
            notificationCount = 0
            Rayfield:Notify({Title = "DEATH", Content = "Đã tắt hệ thống canh sét.", Duration = 2})
        end
    end
})
