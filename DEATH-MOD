local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH HUB | CANH SÉT CHUẨN 3 NHỊP", 
    KeySystem = true, 
    KeySettings = {
        Title = "DEATH KEY SYSTEM", 
        Subtitle = "Nhập key để sử dụng script", 
        Key = "death2026", 
        SaveKey = true
    }
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)
local count = 0
local isRunning = false
local lastPlantTime = 0

Tab:CreateToggle({
    Name = "Đoán sét",
    CurrentValue = false,
    Callback = function(v)
        isRunning = v
        if v then
            count = 0
            Rayfield:Notify({Title = "DEATH HUB", Content = "Đã bật! Hãy trồng cây để hệ thống đếm nhịp...", Duration = 2.5})
            
            -- Lắng nghe khi có vật phẩm/cây mới được thêm vào Workspace (Hành động trồng cây)
            Workspace.DescendantAdded:Connect(function(obj)
                if not isRunning then return end
                
                local n = string.lower(obj.Name)
                -- Lọc các đối tượng liên quan đến việc trồng cây / hạt giống / mầm cây
                if string.find(n, "plant") or string.find(n, "seed") or string.find(n, "tree") or string.find(n, "crop") or string.find(n, "stem") then
                    
                    local currentTime = tick()
                    -- Khoảng cách tối thiểu giữa các lần trồng để tránh đếm trùng
                    if currentTime - lastPlantTime >= 0.8 then
                        lastPlantTime = currentTime
                        count = count + 1
                        
                        if count == 1 then
                            Rayfield:Notify({Title = "Tín hiệu 1", Content = "Đang đếm nhịp giả 1...", Duration = 1})
                        elseif count == 2 then
                            Rayfield:Notify({Title = "Tín hiệu 2", Content = "Đang đếm nhịp giả 2...", Duration = 1})
                        elseif count == 3 then
                            -- Lần thứ 3: Nhịp thật! Tiến hành chờ chuẩn xác trước sét đánh 2 giây
                            Rayfield:Notify({Title = "⚡ Tín hiệu 3 (CHUẨN BỊ)", Content = "Đã khóa mục tiêu, chuẩn bị thu hoạch...", Duration = 1.5})
                            
                            task.delay(2, function()
                                if isRunning then
                                    Rayfield:Notify({
                                        Title = "⚡ THU HOẠCH NGAY!", 
                                        Content = "Đúng thời điểm trước sét 2 giây - Bấm ngay!", 
                                        Duration = 3
                                    })
                                end
                            end)
                            
                            -- Reset lại bộ đếm về 0 để chuẩn bị cho lần trồng cây tiếp theo
                            count = 0
                        end
                    end
                end
            end)
        else
            count = 0
        end
    end
})

-- Nút Hop Server 1 người
Tab:CreateButton({
    Name = "🔄 Đổi Server (Tìm phòng ít người)",
    Callback = function()
        Rayfield:Notify({Title = "SERVER HOP", Content = "Đang tìm server vắng người...", Duration = 2})
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    if s.playing < s.maxPlayers - 1 then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server phù hợp!", Duration = 3})
        end
    end,
})
