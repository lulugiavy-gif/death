            MonitoringConnection = Workspace.DescendantAdded:Connect(function(obj)
                if not IsMonitoring then return end
                local name = string.lower(obj.Name)
                if string.find(name, "lightning") or string.find(name, "strike") or string.find(name, "thunder") then
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local pos = obj:IsA("BasePart") and obj.Position or char.PrimaryPart.Position
                        if (pos - char.PrimaryPart.Position).Magnitude <= 120 then
                            AddNotify("⚡ BÁO ĐỘNG ĐỎ!", "Sét sắp đánh gần bạn, thu hoạch ngay!", 5)
