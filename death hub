local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Window = Rayfield:CreateWindow({
    Name = "⚡ DEATH HUB | CANH SÉT CHUẨN", 
    KeySystem = true, 
    KeySettings = {
        Title = "DEATH KEY SYSTEM", 
        Subtitle = "Nhập key để sử dụng script", 
        Key = "death2026", 
        SaveKey = true
    }
})

local Tab = Window:CreateTab("Canh Sét", 4483363465)
local count = 0
local isRunning = false

Tab:CreateToggle({
    Name = "Đoán sét",
    CurrentValue = false,
    Callback = function(v)
        isRunning = v
        if v then
            count = 0
            Rayfield:Notify({Title = "DEATH HUB", Content = "Đang đếm tín hiệu sét...", Duration = 2.5})
            
            Workspace.DescendantAdded:Connect(function(obj)
                if not isRunning then return end
                
                local n = string.lower(obj.Name)
                if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or string.find(n, "lightning") or string.find(n, "effect") then
                    
                    count = count + 1
                    
                    if count == 3 then
                        -- Lần 3 là thật, chờ đúng 2 giây để báo
                        task.delay(2, function()
                            if isRunning then
                                Rayfield:Notify({
                                    Title = "⚡ ĐOÁN SÉT THẬT", 
                                    Content = "Thu hoạch ngay lập tức!", 
                                    Duration = 2.5
                                })
                            end
                        end)
                        -- Reset bộ đếm để canh đợt tiếp theo
                        count = 0
                    end
                end
            end)
        else
            count = 0
        end
    end
})

-- Nút Hop Server 1 người
Tab:CreateButton({
    Name = "🔄 Đổi Server (Tìm phòng ít người)",
    Callback = function()
        Rayfield:Notify({Title = "SERVER HOP", Content = "Đang tìm server vắng người...", Duration = 2})
        
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.id then
                    if s.playing < s.maxPlayers - 1 then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
        
        if #servers > 0 then
            local targetServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, Players.LocalPlayer)
        else
            Rayfield:Notify({Title = "SERVER HOP", Content = "Không tìm thấy server phù hợp!", Duration = 3})
        end
    end,
})
